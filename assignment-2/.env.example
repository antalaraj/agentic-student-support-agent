# Assignment 2 Environment Configuration
# Copy this file to .env for local development. NEVER commit the real .env file.

# Groq LLM API Key (optional - system defaults to deterministic offline security planner if absent)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Storage & Vectors
DB_PATH=data/student_support_secure.db
CHROMA_DIR=data/chroma
